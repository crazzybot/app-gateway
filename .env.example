# Copy to .env (local dev) or .env.development (docker-compose.dev.yml) and adjust.
# Every value here is validated at startup by src/config/env.ts.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
GATEWAY_BASE_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://gateway:gateway_secret@localhost:5432/gateway_dev

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT signing ──────────────────────────────────────────────────────────────
# Dev/test-only keypair committed under tests/fixtures/keys/ — see the README
# there. Production MUST point these at real, secret-manager-provisioned keys.
JWT_PRIVATE_KEY_PATH=./tests/fixtures/keys/private.pem
JWT_PUBLIC_KEY_PATH=./tests/fixtures/keys/public.pem
JWT_ALGORITHM=RS256
# Stable identifier for the active signing key — must not change across restarts.
JWT_KID=11111111-1111-4111-8111-111111111111
# Optional: a previous key kept in the JWKS response (verify-only) during a
# manual rotation window. Leave both unset outside of a rotation.
# JWT_PREVIOUS_KID=22222222-2222-4222-8222-222222222222
# JWT_PREVIOUS_PUBLIC_KEY_PATH=./tests/fixtures/keys/previous-public.pem

# ── Token lifetimes ────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# ── Password-login scope ──────────────────────────────────────────────────────
# Not defined by the spec (only OAuth flows have an explicit scope source) —
# applied to every password-authenticated login in Phase 1.
DEFAULT_USER_SCOPE="openid profile email api:read"

# ── PII encryption at rest (NFR-6) ────────────────────────────────────────────
# 32 bytes, base64-encoded. Generate your own with: openssl rand -base64 32
# The value below is a dev-only example — never reuse it anywhere real.
ENCRYPTION_KEY=InQ60gtOEuiPljXTssphsMbHb7lsWU9lldsmfSx03YA=

# ── SAML (optional — required only when SAML is enabled; unused in Phase 1) ──
# SAML_SP_ENTITY_ID=
# SAML_SP_CALLBACK_URL=

# ── Upstream proxy (unused in Phase 1, but required by env.ts) ───────────────
UPSTREAM_SERVICES_CONFIG_PATH=./upstream-services.json

# ── Rate limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
